NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# IANA zone the app keeps its calendar in. Required on Vercel (always UTC,
# TZ is reserved there); unset locally the process zone is used. See DEPLOY.md.
NEXT_PUBLIC_APP_TIMEZONE=Asia/Singapore
# Server-only. Lets /api/mcp act as a token's owner (see DEPLOY.md,
# "Connecting Claude"). Local value: `npx supabase status` -> JWT_SECRET.
SUPABASE_JWT_SECRET=
